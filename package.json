{
  "name": "v-backend",
  "version": "3.0.0",
  "description": "Backend do aplicativo Vendinhas",
  "author": "Rafael Cerqueira<rafascerqueira.dev@gmail.com>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "nest start",
    "start:dev": "node scripts/dev-prestart.js && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "test": "jest --watchman=false",
    "test:watch": "jest --watch --watchman=false",
    "test:cov": "jest --coverage --watchman=false",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --watchman=false",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit --watchman=false --passWithNoTests",
    "test:e2e:dev": "jest --config ./test/jest-e2e.json --watch --watchman=false",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "db:seed": "pnpm prisma db seed",
    "avatars:check": "ts-node --transpile-only -r tsconfig-paths/register scripts/remediate-avatars.ts",
    "avatars:fix": "ts-node --transpile-only -r tsconfig-paths/register scripts/remediate-avatars.ts --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.10",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.9",
    "@prisma/adapter-pg": "^7.10.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.81.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "ioredis": "^5.10.1",
    "nodemailer": "^10.4.0",
    "otpauth": "^9.5.0",
    "otplib": "^13.4.0",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "^21.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.9",
    "@prisma/client": "^7.10.1",
    "@prisma/config": "^7.10.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "pg": "^8.20.0",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "modules/**/controllers/**/*.ts",
      "modules/**/services/**/*.ts",
      "shared/**/*.ts",
      "!**/*.spec.ts",
      "!main.ts",
      "!app.module.ts",
      "!**/*.module.ts",
      "!**/dto/**",
      "!**/interfaces/**",
      "!**/config/**",
      "!**/*.d.ts",
      "!**/swagger.config.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "^.+/.+\\.d\\.ts$",
      "<rootDir>/shared/prisma/prisma.module.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/../jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@domain/(.*)$": "<rootDir>/domain/$1",
      "^@infrastructure/(.*)$": "<rootDir>/shared/$1",
      "^@interfaces/(.*)$": "<rootDir>/interfaces/$1"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "fastify@<5.12.8": "^5.12.8",
      "fast-uri@<3.1.9": "^3.1.9",
      "find-my-way@<9.7.0": "^9.7.0",
      "@fastify/busboy@<3.2.5": "^3.2.5",
      "engine.io@<6.6.10": "^6.6.10",
      "socket.io-parser@<4.2.7": "^4.2.7",
      "path-to-regexp@<8.4.0": "^8.4.0",
      "defu@<6.1.5": "^6.1.5",
      "tmp@<0.2.6": "^0.2.6",
      "ws@<8.21.0": "^8.21.0",
      "lodash@<4.18.1": "^4.18.1",
      "js-yaml@<3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "handlebars@<4.7.10": "^4.7.10",
      "piscina@<4.9.4": "^4.9.4",
      "@xhmikosr/decompress@<10.2.2": "^10.2.2",
      "fflate@<0.8.3": "^0.8.3",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "qs@<6.16.1": "^6.16.1",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "@babel/core@<7.29.6": "^7.29.6"
    }
  }
}
